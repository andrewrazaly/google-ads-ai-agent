# ==============================================
# AdGenius AI - Environment Variables
# ==============================================

# --------------------------------------------
# Anthropic Claude API (REQUIRED)
# --------------------------------------------
# Get your API key from: https://console.anthropic.com/
ANTHROPIC_API_KEY="your-anthropic-api-key-here"

# --------------------------------------------
# Google OAuth Configuration (REQUIRED)
# --------------------------------------------
# These credentials handle:
# - User authentication (sign in with Google)
# - Google Ads API access (via user OAuth tokens)
# - Google Analytics API access (via user OAuth tokens)
#
# Setup Instructions:
# 1. Go to: https://console.cloud.google.com/
# 2. Enable APIs: Google Ads API + Google Analytics Data API
# 3. Create OAuth 2.0 Client ID (Web application)
# 4. Add redirect URI: http://localhost:3000/api/auth/callback/google
# 5. Copy Client ID and Secret below

GOOGLE_CLIENT_ID="your-oauth-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-oauth-client-secret"

# --------------------------------------------
# NextAuth Configuration (REQUIRED)
# --------------------------------------------
# Generate NEXTAUTH_SECRET with: openssl rand -base64 32

NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-secret-key-here"

# --------------------------------------------
# Google Ads Developer Token (REQUIRED)
# --------------------------------------------
# Get from: https://ads.google.com/aw/apicenter
# Note: This is a single token shared across all users (not per-user)

GOOGLE_ADS_DEVELOPER_TOKEN="your-developer-token-here"

# --------------------------------------------
# Application Settings
# --------------------------------------------
# Environment: development | production | test
NODE_ENV="development"

# Base URL for the application
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --------------------------------------------
# Optional: Database Configuration
# --------------------------------------------
# PostgreSQL connection string
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# DATABASE_URL="postgresql://postgres:password@localhost:5432/adgenius"

# --------------------------------------------
# Optional: Redis (for caching)
# --------------------------------------------
# REDIS_URL="redis://localhost:6379"

# --------------------------------------------
# Optional: Feature Flags
# --------------------------------------------
# Enable experimental features
# NEXT_PUBLIC_ENABLE_AUTONOMOUS_OPTIMIZATION="false"
# NEXT_PUBLIC_ENABLE_EMAIL_ALERTS="true"
# NEXT_PUBLIC_ENABLE_SLACK_ALERTS="false"

# --------------------------------------------
# Optional: Logging & Monitoring
# --------------------------------------------
# Sentry for error tracking
# SENTRY_DSN=""
# SENTRY_AUTH_TOKEN=""
# LOG_LEVEL="info"

# =============================================================================
# ⚠️  DEPRECATED - NO LONGER NEEDED
# =============================================================================
# The following variables are no longer required since we're using OAuth.
# Users authenticate with their Google account and the app automatically
# receives their credentials.
#
# ❌ GOOGLE_ADS_CLIENT_ID          ← Replaced by GOOGLE_CLIENT_ID (OAuth)
# ❌ GOOGLE_ADS_CLIENT_SECRET      ← Replaced by GOOGLE_CLIENT_SECRET (OAuth)
# ❌ GOOGLE_ADS_REFRESH_TOKEN      ← Users provide via OAuth sign-in
# ❌ GOOGLE_ADS_LOGIN_CUSTOMER_ID  ← Not needed for OAuth flow
# ❌ GOOGLE_CLIENT_EMAIL           ← Not needed for OAuth (Service Account only)
# ❌ GOOGLE_PRIVATE_KEY            ← Not needed for OAuth (Service Account only)
# ❌ GA_PROPERTY_ID                ← Users select their own property
# ❌ NEXT_PUBLIC_GOOGLE_ADS_CUSTOMER_ID ← Users select from their accounts
